#!/bin/bash
# Backup application data (database dump)
# Usage: ./bin/backup [BACKUP_DIR]
# Default: ./backups/
#
# Creates logical dump (SQL) via podman exec, not volume copy.
# Logical dumps work across UID mapping in rootless Podman.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BACKUP_DIR="${1:-./backups}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="$BACKUP_DIR/db_backup_$TIMESTAMP.sql.gz"

echo "Backup Script"
echo "============="
echo "Backup dir: $BACKUP_DIR"
echo "Backup file: $BACKUP_FILE"
echo ""

# Create backup directory
mkdir -p "$BACKUP_DIR"
echo -e "${GREEN}✓${NC} Backup directory ready"
echo ""

# Check if PostgreSQL container is running
echo "Checking PostgreSQL container..."
if ! podman ps --filter "name=app-pgsql" --format "{{.Names}}" | grep -q app-pgsql; then
    echo -e "${RED}✗${NC} PostgreSQL container (app-pgsql) is not running"
    echo "   Start it: systemctl --user start pgsql.service"
    exit 1
fi
echo -e "${GREEN}✓${NC} PostgreSQL is running"
echo ""

# Create database dump via podman exec
echo "Step 1: Creating database dump..."
echo "   (This may take a few minutes for large databases)"

if podman exec app-pgsql \
    pg_dump -U app -d app --no-password --verbose 2>/dev/null | \
    gzip > "$BACKUP_FILE"; then

    file_size=$(ls -lh "$BACKUP_FILE" | awk '{print $5}')
    echo -e "${GREEN}✓${NC} Backup created: $BACKUP_FILE ($file_size)"
else
    echo -e "${RED}✗${NC} Backup failed"
    rm -f "$BACKUP_FILE"
    exit 1
fi
echo ""

# Verify backup is readable and contains expected structure
echo "Step 2: Verifying backup integrity..."
if gunzip -t "$BACKUP_FILE" 2>/dev/null; then
    echo -e "${GREEN}✓${NC} Backup is valid gzip"
else
    echo -e "${RED}✗${NC} Backup is corrupted"
    rm -f "$BACKUP_FILE"
    exit 1
fi

# Check for expected SQL markers
if gunzip -dc "$BACKUP_FILE" | head -20 | grep -qi "PostgreSQL"; then
    echo -e "${GREEN}✓${NC} Backup contains PostgreSQL dump"
else
    echo -e "${YELLOW}⚠${NC} Could not verify SQL content (might still be valid)"
fi
echo ""

# Cleanup old backups (keep only last 30)
echo "Step 3: Cleaning up old backups..."
backup_count=$(ls -1 "$BACKUP_DIR"/db_backup_*.sql.gz 2>/dev/null | wc -l)
if [ $backup_count -gt 30 ]; then
    echo "   Keeping only last 30 backups (found $backup_count)"
    ls -1t "$BACKUP_DIR"/db_backup_*.sql.gz | tail -n +31 | xargs rm -f
    echo -e "${GREEN}✓${NC} Old backups removed"
else
    echo -e "${GREEN}✓${NC} Backup count OK ($backup_count backups)"
fi
echo ""

# Summary
echo "============="
echo -e "${GREEN}Backup successful!${NC}"
echo ""
echo "Backup file: $BACKUP_FILE"
echo "File size: $file_size"
echo ""
echo "To restore this backup, use:"
echo "  ./bin/restore $BACKUP_FILE"
echo ""
echo "Backup retention: Last 30 backups kept automatically"
echo ""

#!/bin/bash
# Restore database from backup
# Usage: ./bin/restore BACKUP_FILE
#
# Restores to running PostgreSQL container via podman exec.
# WARNING: This drops existing database and restores from backup!

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

BACKUP_FILE="$1"

if [ -z "$BACKUP_FILE" ]; then
    echo "Usage: $0 BACKUP_FILE"
    echo ""
    echo "Example:"
    echo "  $0 ./backups/db_backup_20260728_120000.sql.gz"
    exit 1
fi

if [ ! -f "$BACKUP_FILE" ]; then
    echo -e "${RED}✗${NC} Backup file not found: $BACKUP_FILE"
    exit 1
fi

echo "Restore Script"
echo "=============="
echo "Backup file: $BACKUP_FILE"
echo ""
echo -e "${YELLOW}⚠${NC} WARNING: This will DROP the existing database and restore from backup!"
echo "         All current data will be lost."
echo ""

read -p "Are you sure you want to restore? Type 'yes' to confirm: " -r
if [ "$REPLY" != "yes" ]; then
    echo "Restore cancelled"
    exit 0
fi
echo ""

# Check if PostgreSQL container is running
echo "Checking PostgreSQL container..."
if ! podman ps --filter "name=app-pgsql" --format "{{.Names}}" | grep -q app-pgsql; then
    echo -e "${RED}✗${NC} PostgreSQL container (app-pgsql) is not running"
    echo "   Start it: systemctl --user start pgsql.service"
    exit 1
fi
echo -e "${GREEN}✓${NC} PostgreSQL is running"
echo ""

# Verify backup file
echo "Step 1: Verifying backup file..."
if ! gunzip -t "$BACKUP_FILE" 2>/dev/null; then
    echo -e "${RED}✗${NC} Backup file is corrupted or not valid gzip"
    exit 1
fi
echo -e "${GREEN}✓${NC} Backup file is valid"
echo ""

# Drop existing database
echo "Step 2: Dropping existing database..."
if podman exec app-pgsql \
    dropdb -U app -w "app" 2>/dev/null; then
    echo -e "${GREEN}✓${NC} Existing database dropped"
else
    echo -e "${YELLOW}⚠${NC} Could not drop database (might not exist)"
fi
echo ""

# Create empty database
echo "Step 3: Creating empty database..."
if podman exec app-pgsql \
    createdb -U app -w "app" 2>/dev/null; then
    echo -e "${GREEN}✓${NC} Empty database created"
else
    echo -e "${RED}✗${NC} Failed to create database"
    exit 1
fi
echo ""

# Restore from backup
echo "Step 4: Restoring from backup..."
echo "   (This may take a few minutes for large databases)"
if gunzip -dc "$BACKUP_FILE" | \
    podman exec -i app-pgsql \
    psql -U app -d app --no-password 2>/dev/null > /dev/null; then
    echo -e "${GREEN}✓${NC} Restore completed"
else
    echo -e "${RED}✗${NC} Restore failed"
    exit 1
fi
echo ""

# Verify restore
echo "Step 5: Verifying restore..."
if podman exec app-pgsql \
    psql -U app -d app --no-password -c "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='public';" 2>/dev/null | tail -1; then
    echo -e "${GREEN}✓${NC} Database restored and accessible"
else
    echo -e "${RED}✗${NC} Failed to verify restored database"
    exit 1
fi
echo ""

# Summary
echo "=============="
echo -e "${GREEN}Restore successful!${NC}"
echo ""
echo "Restored from: $BACKUP_FILE"
echo ""
echo "Next steps:"
echo "  1. Verify application data: curl http://localhost/up"
echo "  2. Check application logs: journalctl --user -u app.service -f"
echo ""

#!/bin/bash
# Rollback to previous image tag
# Usage: ./bin/rollback [PREVIOUS_TAG]
#
# If no tag specified, uses git tags to find the previous release:
# 1. Lists all tags in reverse order (newest first)
# 2. Current running image must match one of the tags
# 3. Uses the second-most-recent tag as rollback target

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Get current running image tag
current_tag=$(podman ps --filter "name=app-app" --format "{{.Image}}" | sed 's/.*://g')

if [ -z "$current_tag" ]; then
    echo -e "${RED}✗${NC} Could not determine current image tag"
    exit 1
fi

echo "Rollback Script"
echo "==============="
echo "Current tag: $current_tag"
echo ""

# If tag provided, use it
if [ -n "$1" ]; then
    rollback_tag="$1"
else
    # Try to find previous tag from git
    if command -v git &> /dev/null && [ -d ".git" ]; then
        echo "Fetching previous release tag from git..."
        tags=$(git tag --sort=-version:refname | head -10)

        if [ -z "$tags" ]; then
            echo -e "${RED}✗${NC} No git tags found"
            exit 1
        fi

        # Find the tag before current
        found_current=0
        for tag in $tags; do
            if [ $found_current -eq 1 ]; then
                rollback_tag="$tag"
                break
            fi
            if [ "$tag" = "$current_tag" ]; then
                found_current=1
            fi
        done

        if [ -z "$rollback_tag" ]; then
            echo -e "${YELLOW}⚠${NC} No previous tag found, defaulting to 'latest'"
            rollback_tag="latest"
        fi
    else
        echo -e "${YELLOW}⚠${NC} Git not available, defaulting to 'latest'"
        rollback_tag="latest"
    fi
fi

if [ "$rollback_tag" = "$current_tag" ]; then
    echo -e "${YELLOW}⚠${NC} Rollback tag is same as current, aborting"
    exit 0
fi

rollback_image="docker.io/library/myapp:$rollback_tag"
echo "Rollback tag: $rollback_tag"
echo "Rollback image: $rollback_image"
echo ""

# Confirm
read -p "Proceed with rollback? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Rollback cancelled"
    exit 0
fi
echo ""

# Pull rollback image
echo "Step 1: Pulling rollback image..."
if podman pull "$rollback_image"; then
    echo -e "${GREEN}✓${NC} Rollback image ready: $rollback_image"
else
    echo -e "${RED}✗${NC} Failed to pull rollback image"
    exit 1
fi
echo ""

# Stop application services
echo "Step 2: Stopping application services..."
for service in app horizon reverb scheduler; do
    if systemctl --user is-active --quiet "$service.service" 2>/dev/null; then
        echo "   Stopping $service..."
        systemctl --user stop "$service.service"
    fi
done
echo -e "${GREEN}✓${NC} Services stopped"
echo ""

# Update image reference in Quadlet units
echo "Step 3: Updating Quadlet units with rollback image..."
for unit in app.container horizon.container reverb.container scheduler.container; do
    unit_path="$HOME/.config/containers/systemd/$unit"
    if [ -f "$unit_path" ]; then
        sed -i "s|Image=.*|Image=$rollback_image|g" "$unit_path"
        echo "   Updated: $unit"
    fi
done
echo -e "${GREEN}✓${NC} Quadlet units updated"
echo ""

# Reload systemd and restart
echo "Step 4: Reloading systemd and restarting services..."
systemctl --user daemon-reload
for service in app horizon reverb scheduler; do
    echo "   Starting $service..."
    systemctl --user start "$service.service"
done
echo -e "${GREEN}✓${NC} Services restarted with rollback image"
echo ""

# Wait for health
echo "Step 5: Waiting for application to be ready..."
max_attempts=30
attempt=0
while [ $attempt -lt $max_attempts ]; do
    if podman exec app-app curl -fs http://localhost/up > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Application is healthy"
        break
    fi
    attempt=$((attempt + 1))
    if [ $attempt -eq $max_attempts ]; then
        echo -e "${RED}✗${NC} Application failed to become healthy after rollback"
        exit 1
    fi
    echo "   Waiting... ($attempt/$max_attempts)"
    sleep 1
done
echo ""

# Summary
echo "==============="
echo -e "${GREEN}Rollback successful!${NC}"
echo ""
echo "Rolled back from: $current_tag"
echo "Rolled back to:   $rollback_tag"
echo ""
echo "Verify:"
echo "  systemctl --user status app.service"
echo "  curl http://localhost/up"
echo ""

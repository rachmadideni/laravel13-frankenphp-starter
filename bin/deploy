#!/bin/bash
# Production deployment script
# Usage: ./bin/deploy [IMAGE_TAG]
# Default: latest
#
# Procedure:
# 1. Pull new image
# 2. Stop app, horizon, reverb, scheduler (but keep pgsql, redis, minio)
# 3. Run migrations
# 4. Restart all services
# 5. Verify health

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

IMAGE_TAG="${1:-latest}"
IMAGE="docker.io/library/myapp:$IMAGE_TAG"

echo "Deployment Script"
echo "================="
echo "Image: $IMAGE"
echo ""

if [ -z "$SYSTEMD_USER_UNIT_DIR" ]; then
    UNIT_DIR="$HOME/.config/containers/systemd"
else
    UNIT_DIR="$SYSTEMD_USER_UNIT_DIR"
fi

# 1. Pull new image
echo "Step 1: Pulling new image..."
if podman pull "$IMAGE"; then
    echo -e "${GREEN}✓${NC} Image pulled: $IMAGE"
else
    echo -e "${RED}✗${NC} Failed to pull image"
    exit 1
fi
echo ""

# 2. Stop application services (keep infrastructure running)
echo "Step 2: Stopping application services..."
for service in app horizon reverb scheduler; do
    if systemctl --user is-active --quiet "$service.service" 2>/dev/null; then
        echo "   Stopping $service..."
        systemctl --user stop "$service.service"
    fi
done
echo -e "${GREEN}✓${NC} Application services stopped"
echo ""

# 3. Run migrations
echo "Step 3: Running database migrations..."
if podman run --rm \
    --network app \
    -e DB_CONNECTION=pgsql \
    -e DB_HOST=app-pgsql \
    -e DB_PORT=5432 \
    -e DB_DATABASE=app \
    -e DB_USERNAME=app \
    -e DB_PASSWORD=secret \
    "$IMAGE" \
    php artisan migrate --force; then
    echo -e "${GREEN}✓${NC} Migrations completed"
else
    echo -e "${RED}✗${NC} Migrations failed — rollback recommended"
    echo "   Run: ./bin/rollback"
    exit 1
fi
echo ""

# 4. Restart application services
echo "Step 4: Restarting application services..."
for service in app horizon reverb scheduler; do
    echo "   Starting $service..."
    if ! systemctl --user start "$service.service"; then
        echo -e "${RED}✗${NC} Failed to start $service"
        exit 1
    fi
done
echo -e "${GREEN}✓${NC} Application services restarted"
echo ""

# 5. Wait for app to be ready
echo "Step 5: Waiting for application to be ready..."
max_attempts=30
attempt=0
while [ $attempt -lt $max_attempts ]; do
    if podman exec app-app curl -fs http://localhost/up > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Application is healthy"
        break
    fi
    attempt=$((attempt + 1))
    if [ $attempt -eq $max_attempts ]; then
        echo -e "${RED}✗${NC} Application failed to become healthy"
        exit 1
    fi
    echo "   Waiting... ($attempt/$max_attempts)"
    sleep 1
done
echo ""

# 6. Summary
echo "================="
echo -e "${GREEN}Deployment successful!${NC}"
echo ""
echo "Verify:"
echo "  systemctl --user status app.service"
echo "  curl http://localhost/up"
echo "  journalctl --user -u app.service -f"
echo ""
echo "To rollback to previous version:"
echo "  ./bin/rollback"
echo ""
